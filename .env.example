# Environment variables for the East Pipes site.
# Copy the relevant values into `.dev.vars` (local Cloudflare dev) or set them
# as Cloudflare secrets/vars in production. Never commit real secrets.

# --- Tadawul (Saudi Exchange) live market-data feed ---
# Required to enable the official feed. When unset, the site falls back to a
# keyless source and then to static placeholder figures.
TADAWUL_SECURE_KEY=
# Optional — defaults to the listing ticker (1321).
TADAWUL_COMPANY_ID=1321
# Optional — defaults to the production GetDetailQuote endpoint.
# TADAWUL_API_URL=https://webservices.tadawul.com.sa/Tadawul_WebAPI/services/GetDetailQuote

# --- Optional fallback quote source (keyless) ---
# MARKET_QUOTE_URL=https://query1.finance.yahoo.com/v8/finance/chart/1321.SR
